<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|phpunit\.xml|docker-compose\.ya?ml)$ - [F,L,NC]
    RewriteRule ^(vendor/|bootstrap/|config/|database/|resources/|routes/|app/|node_modules/|\.git/) - [F,L,NC]

    RewriteRule ^storage/(app/|framework/|logs/|debugbar/) - [F,L,NC]
    RewriteRule ^storage/.*\.(log|key|sqlite|php|phtml|phar|sh|bat|cmd|pl|py|cgi)$ - [F,L,NC]

    RewriteRule ^storage/.*\.(jpg|jpeg|png|gif|webp|svg|avif|pdf)$ public/$0 [L,NC]

    RewriteRule ^public/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
