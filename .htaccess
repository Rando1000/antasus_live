<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow Let's Encrypt / ACME challenges
    RewriteRule ^\.well-known/ - [L]

    # Security: block dotfiles (.env, .git, etc.) but allow .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Block typical sensitive files
    RewriteRule ^(composer\.(json|lock)|package\.json|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|phpunit\.xml|artisan|docker-compose\.yml)$ - [F,L]

    # Block typical sensitive directories
    RewriteRule ^(vendor/|storage/|bootstrap/|config/|database/|resources/|node_modules/|routes/|app/|\.git/) - [F,L]

    # Avoid loops
    RewriteRule ^public/ - [L]

    # IMPORTANT: only skip rewrite for existing FILES, not directories
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Rewrite everything else into /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
